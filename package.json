{
  "name": "virtual-cloud-chamber",
  "private": true,
  "version": "0.0.0",
  "description": "The Virtual Cloud Chamber — snow crystal growth on a stacked triangular lattice",
  "type": "module",
  "workspaces": [
    "core",
    "solver-cpu",
    "solver-gpu",
    "runner",
    "app"
  ],
  "scripts": {
    "lint:rule7": "node scripts/lint-rule7.mjs",
    "typecheck": "tsc --noEmit && tsc -p app --noEmit",
    "test": "npm run lint:rule7 && npm run typecheck && vitest run",
    "education:verify": "node docs/education/tools/verify.mjs",
    "grow": "node runner/src/main.ts",
    "dev": "npm run dev --workspace app"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.71",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=23.6"
  }
}
